<Window x:Class="LDUninstaller.UI.Dialogs.BulkWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toplu Kaldırma Sihirbazı - LD Uninstaller"
        Height="620" Width="850"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgDark}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Resources/app.ico"
        BorderBrush="{StaticResource BrushBorder}"
        BorderThickness="1">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgSidebar}" MouseDown="TitleBar_MouseDown" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="6" Width="28" Height="28" Margin="0,0,12,0">
                        <TextBlock Text="🗑️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="txtTitle" Text="Kaldırma ve Kalıntı Temizleme Motoru" FontSize="14.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" FontSize="14" Cursor="Hand" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
        </Border>

        <!-- Subheader info banner -->
        <Border Grid.Row="1" Background="#1E293B" Padding="20,12" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrushBorder}">
            <TextBlock x:Name="txtSubHeader" TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" FontSize="12.5" LineHeight="18"
                       Text="Kaldırma işlemi sırasında MSI kilitleri ve süreç çakışmaları otomatik yönetilir. Kaldırma bittiğinde sistem kalıntıları otomatik olarak taranıp ekrana getirilecektir." />
        </Border>

        <!-- Queue Item List -->
        <DataGrid x:Name="dgQueue" Grid.Row="2" Background="Transparent" RowBackground="#161E2E" AlternatingRowBackground="#1A2333"
                  BorderThickness="0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" Foreground="White" FontSize="13"
                  SelectionMode="Single" Margin="20,15">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1E293B" />
                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Padding" Value="0,4" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Uygulama Adı" Binding="{Binding Entry.DisplayName}" Width="280" />
                <DataGridTextColumn Header="Yayıncı" Binding="{Binding Entry.Publisher}" Width="160" />
                <DataGridTextColumn Header="Kaldırıcı Türü" Binding="{Binding Entry.UninstallerKind}" Width="110" />
                <DataGridTemplateColumn Header="Durum" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#1E293B" CornerRadius="5" Padding="8,4" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding StatusMessage}" FontWeight="Medium" FontSize="12" Foreground="#60A5FA" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Options Panel -->
        <Border Grid.Row="3" Background="#161E2E" Padding="20,14" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <CheckBox x:Name="chkRestorePoint" Content="İşlem öncesinde Sistem Geri Yükleme Noktası (Restore Point) oluştur" IsChecked="True" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,8" />
                    <CheckBox x:Name="chkPreferQuiet" Content="Sessiz parametreleri (/VERYSILENT, /S, /qn) tercih et ve Automatizer Daemon'u bağla" IsChecked="True" Style="{StaticResource ModernCheckBox}" />
                </StackPanel>

                <StackPanel x:Name="pnlConcurrent" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Eşzamanlı Sessiz İşlem:" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12.5" />
                    <ComboBox x:Name="cmbConcurrent" SelectedIndex="1" Width="70" Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                        <ComboBoxItem Content="3" />
                        <ComboBoxItem Content="4" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Actions & Progress -->
        <Border Grid.Row="4" Background="{StaticResource BrushBgSidebar}" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <ProgressBar x:Name="pbProgress" Height="8" Margin="0,0,20,6" Background="#1E293B" Foreground="#3B82F6" BorderThickness="0" />
                    <TextBlock x:Name="txtStatus" Text="Hazır. Toplu kaldırmayı başlatmak için butona tıklayın." FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnStart" Content="Kaldırmayı Başlat" Style="{StaticResource ModernBtnPrimary}" Margin="0,0,10,0" Click="BtnStart_Click" />
                    <Button x:Name="btnCancel" Content="Kapat" Style="{StaticResource ModernBtnSecondary}" Click="BtnCancel_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
