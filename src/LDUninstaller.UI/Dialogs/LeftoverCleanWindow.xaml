<Window x:Class="LDUninstaller.UI.Dialogs.LeftoverCleanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalıntı Temizleme Motoru - LD Uninstaller"
        Height="580" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgDark}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI"
        BorderBrush="{StaticResource BrushBorder}"
        BorderThickness="1">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="65" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgSidebar}" MouseDown="TitleBar_MouseDown" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10B981" CornerRadius="6" Width="28" Height="28" Margin="0,0,12,0">
                        <TextBlock Text="🧹" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="txtTitle" Text="Kalıntı ve Artık Temizleme Motoru" FontSize="14.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" FontSize="14" Cursor="Hand" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
        </Border>

        <!-- Backup Alert Banner -->
        <Border Grid.Row="1" Background="#1E293B" Padding="20,12" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrushBorder}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🛡️ " FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="Kayıt defterinden silinecek tüm anahtarlar silinmeden önce otomatik olarak AppData\Local\LDUninstaller\Backups klasörüne .reg yedeği olarak aktarılır." 
                           Foreground="#94A3B8" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Junk Item Grid -->
        <DataGrid x:Name="dgJunk" Grid.Row="2" Background="Transparent" RowBackground="#161E2E" AlternatingRowBackground="#1A2333"
                  BorderThickness="0" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="None" Foreground="White" FontSize="12.5"
                  Margin="20,15">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1E293B" />
                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Seç" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center" 
                                      Click="JunkItemCheckBox_Click"
                                      Style="{StaticResource ModernCheckBox}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tür" Binding="{Binding TypeDisplay}" Width="145" />
                <DataGridTemplateColumn Header="Güven Seviyesi" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="5" Padding="7,3" HorizontalAlignment="Left"
                                    Background="#1E293B">
                                <TextBlock Text="{Binding Confidence}" FontWeight="SemiBold" FontSize="11.5" Foreground="#34D399" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Açıklama / Sebep" Binding="{Binding Reason}" Width="250" />
                <DataGridTextColumn Header="Dosya veya Kayıt Defteri Yolu" Binding="{Binding Path}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty State (When 0 leftovers found) -->
        <Border x:Name="pnlNoJunk" Grid.Row="2" Background="#161E2E" Margin="20,15" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="✨" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Text="Sistemde Kalıntı Bulunamadı!" FontSize="16" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Kaldırılan yazılıma ait tüm dosyalar, AppData dizinleri ve kayıt defteri anahtarları başarıyla temizlendi. Sisteminiz tertemiz!" 
                           Foreground="{StaticResource BrushTextSecondary}" FontSize="13" TextAlignment="Center" MaxWidth="500" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource BrushBgSidebar}" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushBorder}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="chkSelectAll" Content="Tümünü Seç / Seçimi Kaldır" Style="{StaticResource ModernCheckBox}" Checked="ChkSelectAll_Changed" Unchecked="ChkSelectAll_Changed" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtCount" Text="0 öğe seçildi" Margin="25,0,0,0" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" FontSize="12.5" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="btnClean" Content="Seçilen Kalıntıları Temizle" Style="{StaticResource ModernBtnPrimary}" Margin="0,0,10,0" Click="BtnClean_Click" />
                    <Button Content="Kapat" Style="{StaticResource ModernBtnSecondary}" Click="BtnClose_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
