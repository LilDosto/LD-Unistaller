<Window x:Class="LDUninstaller.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LDUninstaller.UI.Controls"
        Title="LD Uninstaller - Gelişmiş Sistem ve Toplu Yazılım Kaldırıcı"
        Height="800" Width="1280"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDark}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Resources/app.ico"
        BorderBrush="{StaticResource BrushBorder}"
        BorderThickness="1">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource BrushBgSidebar}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource BrushBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Brand / Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Border CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Resources/logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LD Uninstaller" FontSize="15" FontWeight="Bold" Foreground="White" />
                        <TextBlock x:Name="txtAppVersion" Text="v2.4.0" FontSize="11" Foreground="#60A5FA" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="1" Margin="14,15,14,0">
                    <RadioButton x:Name="navApps" Content="📦  Yazılımlar" Style="{StaticResource SidebarNavBtn}" IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="navTreemap" Content="🗺️  Disk Haritası" Style="{StaticResource SidebarNavBtn}" Checked="Nav_Checked" />
                    <RadioButton x:Name="navStartup" Content="⚡  Başlangıç Yöneticisi" Style="{StaticResource SidebarNavBtn}" Checked="Nav_Checked" />
                    <RadioButton x:Name="navDebloat" Content="🛡️  Windows Debloat" Style="{StaticResource SidebarNavBtn}" Checked="Nav_Checked" />
                </StackPanel>

                <!-- Sidebar Footer Status -->
                <Border Grid.Row="2" Background="#161E2E" Padding="16,14" Margin="12" CornerRadius="8" BorderThickness="1" BorderBrush="#253045">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="Sistem Koruması Aktif" FontSize="11.5" FontWeight="SemiBold" Foreground="#34D399" />
                        </StackPanel>
                        <TextBlock Text="Otomatik .REG yedekleme ve çakışma önleyici açık." FontSize="10.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT AREA ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- Custom Window Titlebar & Header -->
            <Border Grid.Row="0" Background="{StaticResource BrushBgSidebar}" MouseDown="TitleBar_MouseDown" Padding="20,0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrushBorder}">
                <Grid>
                    <!-- Search Bar in Header -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Background="#1F2937" CornerRadius="7" Width="320" Height="32" BorderThickness="1" BorderBrush="{StaticResource BrushBorder}">
                            <Grid>
                                <TextBlock Text="🔍" FontSize="11" Foreground="#6B7280" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <TextBox x:Name="txtSearch" Background="Transparent" Foreground="White" BorderThickness="0" Margin="28,2,10,0" VerticalAlignment="Center" FontSize="12.5" TextChanged="TxtSearch_TextChanged" />
                                <TextBlock Text="Uygulama veya yayıncı ara..." Foreground="#6B7280" Margin="30,0,0,0" VerticalAlignment="Center" FontSize="12" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Window Control Buttons (Minimize, Maximize, Close) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" Width="32" Height="32" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" FontSize="12" Cursor="Hand" Click="BtnMinimize_Click" />
                        <Button Content="▢" Width="32" Height="32" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" FontSize="12" Cursor="Hand" Click="BtnMaximize_Click" />
                        <Button Content="✕" Width="32" Height="32" Background="Transparent" Foreground="#EF4444" BorderThickness="0" FontSize="14" Cursor="Hand" Click="BtnClose_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= CONNECTED DRIVES TABS ================= -->
            <Border x:Name="pnlDriveTabs" Grid.Row="1" Background="#131B2A" Padding="20,8" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrushBorder}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="💾 Diskler:" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Drive Tabs Container -->
                    <WrapPanel x:Name="wpDriveTabs" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" />

                    <!-- Selected Drive Badge -->
                    <Border x:Name="bdDriveSelectedInfo" Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock x:Name="txtDriveSelectedInfo" Text="Tüm Diskler" FontSize="11.5" Foreground="#60A5FA" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <!-- ================= VIEW 1: APPLICATIONS ================= -->
            <Grid x:Name="viewApps" Grid.Row="2" Margin="20,16,20,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Actions & Stats Row -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Filter Chips -->
                    <WrapPanel VerticalAlignment="Center">
                        <RadioButton x:Name="chipAll" Content="Tümü" IsChecked="True" Checked="FilterChip_Checked" Style="{StaticResource SidebarNavBtn}" Padding="10,5" Margin="0,0,6,0" FontSize="12" />
                        <RadioButton x:Name="chipDesktop" Content="Masaüstü" Checked="FilterChip_Checked" Style="{StaticResource SidebarNavBtn}" Padding="10,5" Margin="0,0,6,0" FontSize="12" />
                        <RadioButton x:Name="chipStore" Content="Windows Store" Checked="FilterChip_Checked" Style="{StaticResource SidebarNavBtn}" Padding="10,5" Margin="0,0,6,0" FontSize="12" />
                        <RadioButton x:Name="chipSteam" Content="Steam Oyunları" Checked="FilterChip_Checked" Style="{StaticResource SidebarNavBtn}" Padding="10,5" Margin="0,0,6,0" FontSize="12" />
                        <RadioButton x:Name="chipOrphan" Content="Yetim / Sahipsiz" Checked="FilterChip_Checked" Style="{StaticResource SidebarNavBtn}" Padding="10,5" Margin="0,0,6,0" FontSize="12" />
                        <RadioButton x:Name="chipSystem" Content="Sistem Bileşenleri" Checked="FilterChip_Checked" Style="{StaticResource SidebarNavBtn}" Padding="10,5" Margin="0,0,6,0" FontSize="12" />
                    </WrapPanel>

                    <!-- Top Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnUninstall" Content="🗑️  Kaldır" Style="{StaticResource ModernBtnPrimary}" Margin="0,0,10,0" Click="BtnUninstall_Click" />
                        <Button Content="📤 Dışa Aktar" Style="{StaticResource ModernBtnSecondary}" Margin="0,0,8,0" Click="BtnExport_Click" />
                        <Button Content="🔄 Yenile" Style="{StaticResource ModernBtnSecondary}" Click="BtnRefresh_Click" />
                    </StackPanel>
                </Grid>

                <!-- Legend pills -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Doğrulanmış Sertifika" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Ellipse Width="8" Height="8" Fill="#3B82F6" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Standart Yazılım" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Yetim / Sahipsiz" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Ellipse Width="8" Height="8" Fill="#8B5CF6" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Store / UWP" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#6B7280" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Sistem Bileşeni" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>

                <!-- DataGrid Virtual List -->
                <DataGrid x:Name="dgApps" Grid.Row="2" Background="Transparent" RowBackground="#131B2A" AlternatingRowBackground="#172236"
                          BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="None" Foreground="White" FontSize="12.5"
                          SelectionMode="Extended" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E293B" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="#1E293B" Foreground="White">
                            <MenuItem Header="🗑️ Kaldır" Click="BtnUninstall_Click" />
                            <Separator Background="{StaticResource BrushBorder}" />
                            <MenuItem Header="📁 Kurulum Klasörünü Aç" Click="MenuOpenFolder_Click" />
                            <MenuItem Header="🔑 Kayıt Defterinde Aç" Click="MenuOpenReg_Click" />
                            <MenuItem Header="🌐 Web'de Ara" Click="MenuSearchWeb_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ModernCheckBox}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Uygulama Adı" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Margin="4,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#3B82F6" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCertificateValid}" Value="True">
                                                            <Setter Property="Fill" Value="#10B981" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOrphaned}" Value="True">
                                                            <Setter Property="Fill" Value="#EF4444" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UninstallerKind}" Value="StoreApp">
                                                            <Setter Property="Fill" Value="#8B5CF6" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SystemComponent}" Value="True">
                                                            <Setter Property="Fill" Value="#6B7280" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Yayıncı" Binding="{Binding Publisher}" Width="180" />
                        <DataGridTextColumn Header="Sürüm" Binding="{Binding DisplayVersion}" Width="100" />
                        <DataGridTemplateColumn Header="Boyut" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding EstimatedSize}" FontWeight="SemiBold" FontSize="11.5" Foreground="#60A5FA" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Kaldırıcı Türü" Binding="{Binding UninstallerKind}" Width="120" />
                        <DataGridTemplateColumn Header="Sertifika" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="—" />
                                                <Setter Property="Foreground" Value="#6B7280" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCertificateValid}" Value="True">
                                                        <Setter Property="Text" Value="✓ Doğrulandı" />
                                                        <Setter Property="Foreground" Value="#34D399" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Collapsible Bottom Treemap Preview -->
                <Border x:Name="pnlMiniTreemap" Grid.Row="3" Height="140" Margin="0,10,0,0" CornerRadius="8" Background="#161E2E" BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" ClipToBounds="True">
                    <Grid>
                        <controls:WpfSquarifiedTreeMap x:Name="miniTreeMap" />
                        <Button Content="✕" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Background="#263449" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnHideMiniTreemap_Click" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= VIEW 2: FULL TREEMAP ================= -->
            <Grid x:Name="viewTreemap" Grid.Row="2" Margin="20,16,20,10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Disk Kullanımı Squarified Ağaç Haritası (Boyuta Göre Görsel Dağılım)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Border Grid.Row="1" CornerRadius="10" Background="#161E2E" BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" ClipToBounds="True">
                    <controls:WpfSquarifiedTreeMap x:Name="fullTreeMap" />
                </Border>
            </Grid>

            <!-- ================= VIEW 3: STARTUP MANAGER ================= -->
            <Grid x:Name="viewStartup" Grid.Row="2" Margin="20,16,20,10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Windows Başlangıç Uygulamaları ve Servisleri" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Windows 10/11 StartupApproved standardı ile programlar silinmeden güvenle kapatılabilir." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Content="Durumu Değiştir (Aç/Kapat)" Style="{StaticResource ModernBtnPrimary}" HorizontalAlignment="Right" Click="BtnToggleStartup_Click" />
                </Grid>

                <DataGrid x:Name="dgStartup" Grid.Row="1" Background="Transparent" RowBackground="#131B2A" AlternatingRowBackground="#172236"
                          BorderThickness="1" BorderBrush="{StaticResource BrushBorder}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" Foreground="White" FontSize="12.5">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E293B" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Uygulama / Öğe Adı" Binding="{Binding Name}" Width="240" />
                        <DataGridTextColumn Header="Kaynak Türü" Binding="{Binding Type}" Width="140" />
                        <DataGridTemplateColumn Header="Durum" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="5" Padding="8,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1E293B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="Background" Value="#064E3B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontWeight="SemiBold" FontSize="11.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Devre Dışı" />
                                                    <Setter Property="Foreground" Value="#9CA3AF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                            <Setter Property="Text" Value="Etkin" />
                                                            <Setter Property="Foreground" Value="#34D399" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Komut / Hedef Yol" Binding="{Binding Command}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ================= VIEW 4: DEBLOAT ================= -->
            <Grid x:Name="viewDebloat" Grid.Row="2" Margin="20,16,20,10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Windows Telemetri ve Performans İnce Ayarları" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Gereksiz arka plan telemetri servislerini, Cortana aramalarını ve otomatik sponsorlu yazılımları kapatın." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Content="Tüm Önerilenleri Uygula" Style="{StaticResource ModernBtnPrimary}" HorizontalAlignment="Right" Click="BtnApplyAllDebloat_Click" />
                </Grid>

                <ItemsControl x:Name="icDebloat" Grid.Row="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#161E2E" CornerRadius="8" Padding="18,14" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{StaticResource BrushBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="White" />
                                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="#60A5FA" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Uygula / Değiştir" Style="{StaticResource ModernBtnSecondary}" VerticalAlignment="Center" Tag="{Binding}" Click="BtnToggleDebloatItem_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ================= BOTTOM STATUS BAR ================= -->
            <Border Grid.Row="3" Background="{StaticResource BrushBgSidebar}" Padding="20,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushBorder}">
                <Grid VerticalAlignment="Center">
                    <TextBlock x:Name="txtFooterStatus" Text="Hazır." FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="txtFooterStats" Text="231 Uygulama | 184.2 GB Toplam Boyut" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
